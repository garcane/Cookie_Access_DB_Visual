table Customers

	column 'Customer ID'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: customer_id

	column 'First Name'
		dataType: string
		summarizeBy: none
		sourceColumn: first_name

	column 'Last Name'
		dataType: string
		summarizeBy: none
		sourceColumn: last_name

	column 'Email Address'
		dataType: string
		summarizeBy: none
		sourceColumn: email_address

	column Phone
		dataType: string
		summarizeBy: none
		sourceColumn: phone

	column Address
		dataType: string
		summarizeBy: none
		sourceColumn: address

	column City
		dataType: string
		summarizeBy: none
		sourceColumn: city

	column State
		dataType: string
		summarizeBy: none
		sourceColumn: state

	column Zip
		dataType: string
		summarizeBy: none
		sourceColumn: zip

	column Country
		dataType: string
		summarizeBy: none
		sourceColumn: country

	column Notes
		dataType: string
		summarizeBy: none
		sourceColumn: notes

	column 'Customer Name' = Customers[First Name] & " " & Customers[Last Name]
		dataType: string
		summarizeBy: none

	partition Customers = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost", "cookie_creations"),
					customers = Source{[Schema="public",Item="customers"]}[Data]
				in
					customers

	annotation PBI_ResultType = Table

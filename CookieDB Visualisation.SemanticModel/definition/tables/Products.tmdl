table Products

	column 'Product ID'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: product_id

	column 'Cookie Name'
		dataType: string
		summarizeBy: none
		sourceColumn: cookie_name

	column Price
		dataType: decimal
		formatString: "£"#,0.00
		summarizeBy: none
		sourceColumn: price

	partition Products = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost", "cookie_creations"),
					products = Source{[Schema="public",Item="products"]}[Data],
					Typed = Table.TransformColumnTypes(products, {{"price", Currency.Type}})
				in
					Typed

	annotation PBI_ResultType = Table
